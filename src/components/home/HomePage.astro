---
/**
 * HomePage — renders the homepage from the locale JSON `home` namespace.
 *
 * Data-driven: changing src/locales/en.json updates the homepage without
 * touching this component.
 *
 * Sections (top to bottom):
 *   1. CinematicHero — full-bleed trailer still, film-poster title, chapter row
 *   2. VideoSection  — official trailer on a dark cinema band
 *   3. StatsStrip    — "1.0 at a glance" verified numbers band
 *   4. QuickStart    — four ordered still cards (Beginner / Builds / Sparkworks / Cinder's Cradle)
 *   5. Recent Updates + 1.0 index (editorial index + sidebar)
 *   6. QuickAnswers  — sourced quick answers + how-this-wiki-is-dated card
 *   7. ClosingCta    — moonlit still + journey CTA
 *
 * The page is full-bleed (LocaleLayout `fullBleed`), so sections own their
 * max-width. The dark bands are intentionally theme-independent: they are the
 * page's "screening room", while the reading sections follow the site theme.
 */
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import LocaleLayout from '~/components/layout/LocaleLayout.astro';
import CinematicHero from '~/components/home/CinematicHero.astro';
import VideoSection from '~/components/home/VideoSection.astro';
import StatsStrip from '~/components/home/StatsStrip.astro';
import QuickStart from '~/components/home/QuickStart.astro';
import QuickAnswers from '~/components/home/QuickAnswers.astro';
import SectionHeading from '~/components/home/SectionHeading.astro';
import { site } from '~/config/site';
import { NAVIGATION_CONFIG } from '~/config/navigation';
import { cinematicArt } from '~/config/cinematic';
import { type Locale } from '~/i18n/routing';
import { getUi, type HomeUi } from '~/i18n/ui';
import { getRecentEntries, parseEntryId } from '~/lib/content';
import { absoluteLocalized, localizePath, listPath, detailPath } from '~/lib/url';

interface Props {
  locale: Locale;
  jsonLd?: Record<string, unknown>[];
  /** hreflang alternates (built by the route page). */
  alternates?: Array<{ hreflang: string; href: string }>;
}
const { locale, jsonLd = [], alternates = [] } = Astro.props;
const ui = getUi(locale);
// Typed straight from en.json (HomeUi) — no `as any`: a renamed key now
// fails typecheck instead of silently blanking the block (check-i18n only
// compares locale↔en, not component↔en; tests/home-ui.test.ts pins the
// access surface at the JSON level too).
const home = ui.home;
const shared = ui.shared;

const recent = await getRecentEntries(locale, 6);
const guidesPath = listPath(NAVIGATION_CONFIG[0]?.key ?? 'guides', locale);

// Per-field fallbacks: a locale JSON whose meta object exists but lacks
// title/description must not pass undefined into BaseLayout (title.includes
// crashes the build) — same spirit as the ?? defaults below.
const meta = {
  title: home.meta?.title ?? site.name,
  description: home.meta?.description ?? site.description,
};
// Section namespaces come from en.json verbatim (getUi deep-merges non-en
// locales over en), so every key is guaranteed present — no per-section
// `{ cards: [] }`-style fallbacks and no hardcoded English anywhere. A key
// missing from en.json itself is a build-time typecheck failure, not a
// blanked section at runtime.
const hero: HomeUi['hero'] = home.hero;
const trailer: HomeUi['trailer'] = home.trailer;
const stats: HomeUi['stats'] = home.stats;
const updates: HomeUi['updates'] = home.updates;
const start: HomeUi['start'] = home.start;
const popular: HomeUi['popular'] = home.popular;
const quickAnswers: HomeUi['quickAnswers'] = home.quickAnswers;
const method: HomeUi['method'] = home.method;
const closingCta: HomeUi['closingCta'] = home.closingCta;

// QuickLink may be a string or { label, href } — normalize for the sidebar list.
type QuickLink = string | { label: string; href: string };
const trendingLinks: QuickLink[] = Array.isArray(popular.quickLinks) ? popular.quickLinks : [];
function trendingHref(link: QuickLink): string | null {
  return typeof link === 'string' ? null : localizePath(link.href, locale);
}
function trendingLabel(link: QuickLink): string {
  return typeof link === 'string' ? link : link.label;
}

// Dated pages are the site's promise — show the date on every recent row.
const dateFormatter = new Intl.DateTimeFormat(locale === 'en' ? 'en-US' : locale, {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
});
const formatDate = (date: Date) => dateFormatter.format(date);
const isoDate = (date: Date) => date.toISOString().slice(0, 10);

const isExternal = (href: string) => /^https?:\/\//.test(href);
const resolveHref = (href: string) => (isExternal(href) ? href : localizePath(href, locale));
---

<LocaleLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  alternates={alternates}
  jsonLd={jsonLd}
  fullBleed
  image={absoluteLocalized(cinematicArt.og.src)}
  ogImageWidth={1200}
  ogImageHeight={630}
>
  {/* ─────────────────────────────── Hero ─────────────────────────────── */}
  <CinematicHero
    locale={locale}
    title={hero.title}
    titleLead={hero.titleLead}
    titleTail={hero.titleTail}
    eyebrow={hero.eyebrow}
    metaLabel={hero.metaLabel}
    description={hero.description}
    primaryLabel={hero.ctaPrimary}
    primaryHref={hero.ctaPrimaryHref}
    secondaryLabel={hero.ctaSecondary}
    secondaryHref={hero.ctaSecondaryHref}
    trailerLabel={hero.ctaTrailer}
    hasTrailer={Boolean(hero.videoId)}
    image={cinematicArt.hero}
    imageAlt={hero.imageAlt}
    imageCredit={hero.imageCredit}
    imageCreditHref={hero.imageCreditHref}
    chapters={hero.chapters}
  />

  {/* Trailer — only renders when a videoId is configured. */}
  {hero.videoId && (
    <VideoSection
      videoId={hero.videoId}
      badge={trailer.badge}
      title={trailer.title}
      description={trailer.description}
      ctaLabel={trailer.ctaLabel}
      ctaHref={trailer.ctaHref}
      credit={trailer.credit}
    />
  )}

  {/* ──────────────────────── 1.0 at a glance ─────────────────────────── */}
  <StatsStrip
    locale={locale}
    badge={stats.badge}
    title={stats.title}
    description={stats.description}
    items={stats.items}
    note={stats.note}
    facts={`${site.game.developer} · ${site.game.platform} · ${site.game.genre}`}
    linkLabel={stats.linkLabel}
    href={stats.href}
  />

  {/* ───────────────────────────── Quick Start ────────────────────────── */}
  <QuickStart locale={locale} badge={start.badge} title={start.title} cards={start.cards} />

  {/* ───────────────────── Recent Updates + 1.0 index ───────────────────── */}
  <section class="section border-t border-border">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]">
      {/* Recent updates — editorial index, 2/3 width on desktop. */}
      <div class="min-w-0">
        <SectionHeading eyebrow={updates.badge} title={updates.title}>
          <a
            href={guidesPath}
            class="group inline-flex items-center gap-2 text-[10px] font-semibold uppercase tracking-[0.2em] text-muted-foreground transition hover:text-nav"
          >
            {shared.browseAll}
            <Icon
              name="lucide:arrow-right"
              class="h-3.5 w-3.5 transition group-hover:translate-x-0.5"
            />
          </a>
        </SectionHeading>

        {recent.length === 0 ? (
          <p class="mt-8 text-sm text-muted-foreground">{shared.noArticles}</p>
        ) : (
          <div class="grid gap-x-10 sm:grid-cols-2">
            {recent.map((entry) => {
              const parsed = parseEntryId(entry.id);
              if (!parsed) return null;
              const modified = entry.data.lastModified ?? entry.data.date;
              return (
                <a
                  href={detailPath(parsed.category, parsed.slug, locale)}
                  class="group flex gap-4 border-b border-border py-5"
                >
                  <div class="min-w-0 flex-1">
                    <div class="flex flex-wrap items-center gap-x-2 text-[10px] uppercase tracking-[0.18em] text-muted-foreground">
                      <span class="text-nav">{parsed.category}</span>
                      <span aria-hidden="true">·</span>
                      <time datetime={isoDate(modified)}>{formatDate(modified)}</time>
                    </div>
                    <h3 class="mt-1.5 font-display text-xl font-medium leading-snug transition group-hover:text-nav md:text-[1.35rem]">
                      {entry.data.title}
                    </h3>
                    <p class="mt-1 line-clamp-2 text-sm leading-relaxed text-muted-foreground">
                      {entry.data.description}
                    </p>
                  </div>
                  <Icon
                    name="lucide:arrow-up-right"
                    class="mt-1 h-4 w-4 shrink-0 text-muted-foreground/40 transition group-hover:text-nav"
                  />
                </a>
              );
            })}
          </div>
        )}
      </div>

      {/* 1.0 index — 1/3 width sidebar. */}
      {trendingLinks.length > 0 && (
        <aside class="hidden lg:block lg:border-l lg:border-border lg:pl-10">
          <p class="cinema-eyebrow text-muted-foreground">{popular.badge}</p>
          <h2 class="mt-2 font-display text-2xl font-medium tracking-tight md:text-3xl">
            {popular.title}
          </h2>
          <ul class="mt-5">
            {trendingLinks.map((link: QuickLink, index: number) => {
              const href = trendingHref(link);
              const label = trendingLabel(link);
              return (
                <li class="border-t border-border">
                  {href ? (
                    <a
                      href={href}
                      class="group flex items-center gap-3 py-3.5 text-sm font-medium text-foreground transition hover:text-nav"
                    >
                      <span class="font-display text-sm text-muted-foreground/50">
                        {String(index + 1).padStart(2, '0')}
                      </span>
                      <span class="leading-snug">{label}</span>
                      <Icon
                        name="lucide:arrow-up-right"
                        class="ml-auto h-3.5 w-3.5 shrink-0 text-muted-foreground/40 transition group-hover:text-nav"
                      />
                    </a>
                  ) : (
                    <div class="flex items-center gap-3 py-3.5 text-sm font-medium">
                      <span class="font-display text-sm text-muted-foreground/50">
                        {String(index + 1).padStart(2, '0')}
                      </span>
                      <span class="leading-snug">{label}</span>
                    </div>
                  )}
                </li>
              );
            })}
          </ul>
        </aside>
      )}
    </div>
  </section>

  {/* ───────────────────── Quick answers + method ─────────────────────── */}
  <QuickAnswers
    locale={locale}
    badge={quickAnswers.badge}
    title={quickAnswers.title}
    description={quickAnswers.description}
    ctaLabel={quickAnswers.ctaLabel}
    ctaHref={quickAnswers.ctaHref}
    items={quickAnswers.items}
    method={method}
  />

  {/* ─────────────────────────────── Final CTA ────────────────────────── */}
  {
    closingCta.title && (
      <section class="relative isolate overflow-hidden border-t border-white/10 bg-cinema-bg text-white">
        <Image
          src={cinematicArt.closing}
          alt=""
          widths={[800, 1200, 1800, 2200]}
          sizes="100vw"
          quality={78}
          loading="lazy"
          class="absolute inset-0 -z-10 h-full w-full object-cover object-[68%_50%] opacity-70"
        />
        <div class="cinema-scrim-cta" aria-hidden="true"></div>
        <div class="film-grain" aria-hidden="true"></div>
        <div
          class="relative mx-auto max-w-7xl px-4 py-24 md:py-32"
        >
          <div class="max-w-xl">
            <p class="cinema-eyebrow text-nav-light">{closingCta.badge}</p>
            <h2 class="mt-4 font-display text-4xl font-medium leading-[1.05] tracking-tight md:text-6xl">
              {closingCta.title}
            </h2>
            <p class="mt-5 max-w-lg text-base leading-relaxed text-white/60">
              {closingCta.description}
            </p>
            <div class="mt-8 flex flex-wrap items-center gap-3">
              <a
                href={resolveHref(closingCta.primaryHref)}
                class="group inline-flex items-center gap-3 rounded-full bg-cinema-paper px-6 py-3 text-sm font-semibold text-cinema-ink transition hover:bg-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
              >
                {closingCta.primary}
                <Icon
                  name="lucide:arrow-right"
                  class="h-4 w-4 transition group-hover:translate-x-0.5"
                />
              </a>
              <a
                href={resolveHref(closingCta.secondaryHref)}
                target={isExternal(closingCta.secondaryHref) ? '_blank' : undefined}
                rel={isExternal(closingCta.secondaryHref) ? 'noopener noreferrer' : undefined}
                class="inline-flex items-center gap-2 rounded-full border border-white/25 px-6 py-3 text-sm font-medium text-white/90 transition hover:border-white/60 hover:bg-white/5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
              >
                {closingCta.secondary}
              </a>
            </div>
            <a
              href={closingCta.imageCreditHref}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-12 inline-flex items-center gap-2 text-[10px] uppercase tracking-[0.18em] text-white/45 transition hover:text-white/70"
            >
              <Icon name="lucide:film" class="h-3 w-3 shrink-0" />
              {closingCta.imageCredit}
            </a>
          </div>
        </div>
      </section>
    )
  }
</LocaleLayout>
